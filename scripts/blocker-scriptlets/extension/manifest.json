{
  "manifest_version": 3,
  "name": "Zephium scriptlets spike",
  "version": "1.0",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["program.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true,
    "world": "MAIN"
  }]
}
