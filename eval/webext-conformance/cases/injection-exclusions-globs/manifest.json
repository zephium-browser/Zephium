{
  "manifest_version": 3,
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "exclude_matches": ["http://127.0.0.1/*?excluded=*"],
      "include_globs": ["*included*"],
      "exclude_globs": ["*skip*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
