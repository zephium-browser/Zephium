{
  "manifest_version": 3,
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["top.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["all.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
