{
  "manifest_version": 3,
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["first.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["second.js"],
      "run_at": "document_end"
    }
  ]
}
