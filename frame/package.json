{
  "name": "@zephium/frame",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.onboarding.config.ts",
    "budgets": "vite build --mode budgets && vite build --config vite.onboarding.config.ts --mode budgets",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run stylelint && pnpm run format:check && pnpm run knip && pnpm run test",
    "typecheck": "pnpm run i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc6 --project tsconfig.node.json",
    "test": "vitest run --project unit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/i18n --emit-ts-declarations --strategy baseLocale",
    "test:component": "vitest run --project component",
    "stylelint": "stylelint \"src/**/*.{css,svelte}\"",
    "knip": "knip",
    "check:styles": "node scripts/check-styles.mjs",
    "kept-site-rasters": "node scripts/kept-site-rasters.mjs"
  },
  "dependencies": {
    "@hugeicons/svelte": "1.1.5",
    "@tauri-apps/api": "2.12.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-blockquote": "3.31.4",
    "@tiptap/extension-bold": "3.31.4",
    "@tiptap/extension-bullet-list": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-heading": "3.31.4",
    "@tiptap/extension-horizontal-rule": "3.31.4",
    "@tiptap/extension-italic": "3.31.4",
    "@tiptap/extension-list-item": "3.31.4",
    "@tiptap/extension-ordered-list": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-strike": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@xyflow/svelte": "1.7.0",
    "bits-ui": "2.19.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "elkjs": "0.12.0",
    "layerchart": "2.5.0",
    "marked": "18.0.14",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hugeicons/core-free-icons": "4.3.5",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24.19.0",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "knip": "^6.39.0",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "^3.1.0"
  }
}
